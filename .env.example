# -----------------------------------------------------------------------------
# Syxlor BG Remover — environment template
# Copy this file to .env, then add the key for the provider you want to use.
# Never commit .env or place API keys in frontend code.
# -----------------------------------------------------------------------------
# Provider switching: set AI_PROVIDER to fal, gemini, deepseek, or openai.
# Only the selected provider key is required. Restart the server after changes.
# For production, configure secrets in your hosting platform instead of a file.

# Server
PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Select the active image processor
AI_PROVIDER=gemini

# OpenAI (used when AI_PROVIDER=openai)
# Model must support image input and JSON Chat Completions. Available choices
# commonly include gpt-4o-mini (fast/value), gpt-4o, gpt-4.1-mini, gpt-4.1-nano.
# Access varies by project. Set OPENAI_MODEL and restart to switch models.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# fal.ai (used when AI_PROVIDER=fal; account balance is required)
FAL_KEY=
FAL_MODEL=fal-ai/birefnet/v2
FAL_OPERATING_RESOLUTION=1024x1024

# Google Gemini (used when AI_PROVIDER=gemini). Working model choices should
# support generateContent with image input. This setup uses gemini-3.5-flash-lite
# and falls back to gemini-3-flash-preview; check models available to your key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview
GEMINI_REQUEST_TIMEOUT_MS=90000
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=8192

# DeepSeek (used when AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Upload limits (20971520 bytes = 20 MiB)
MAX_FILE_SIZE_BYTES=20971520
MAX_IMAGE_PIXELS=100000000
