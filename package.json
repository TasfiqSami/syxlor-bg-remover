{
  "name": "syxlor-bg-remover",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node -e \"process.env.NODE_ENV='production'; import('./dist/server/index.js')\"",
    "check": "tsc -b --pretty",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.7",
    "@google/genai": "^1.30.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fflate": "^0.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "sharp@0.35.5": true,
    "protobufjs@7.6.6": true,
    "@google/genai@1.52.0": true
  }
}
